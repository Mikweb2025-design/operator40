{
  "name": "operator40",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "description": "Operator 40 — allenamento funzionale per over 40. iOS (Capacitor) + Mac (PWA/Electron).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/version-sw.mjs",
    "preview": "vite preview",
    "fetch:mediapipe": "node scripts/fetch-mediapipe.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:local": "node scripts/deploy.mjs --local",
    "deploy:remote": "node scripts/deploy.mjs --remote",
    "deploy:full": "node scripts/deploy.mjs --local --remote --ios",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:add:mac": "cap add @capacitor-community/electron",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:open:mac": "cap open @capacitor-community/electron"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/motion": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "vite": "^5.4.10",
    "vitest": "^1.6.1"
  }
}
